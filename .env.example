# ==============================================================================
# EV Charging Calculator - Variáveis de Ambiente
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores conforme o ambiente:
# - Local (Dev): porta 3000, banco local
# - Homologação (HML): porta 3001, banco HML
# - Produção (PROD): porta 3000, banco PROD
# ==============================================================================

# Ambiente de execução: development | production | test
NODE_ENV=development

# Porta HTTP exposta pelo contêiner app-server (3001 para não colidir com outros serviços)
APP_PORT=3001

# IP de escuta (0.0.0.0 no Docker local / 127.0.0.1 atrás do Nginx na VPS)
APP_BIND_IP=0.0.0.0

# Nomes dos contêineres Docker
APP_CONTAINER_NAME=ev-calc-app-local
DB_CONTAINER_NAME=ev-calc-db-local

# Configurações do PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ev_calculator_dev
POSTGRES_HOST_PORT=5433

# URL de Conexão do Prisma ORM (construída automaticamente nos scripts ou Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@app-db:5432/ev_calculator_dev?schema=public

# Chave secreta da aplicação (sessões, JWT, criptografia)
APP_SECRET=defina_uma_chave_secreta_forte_e_aleatoria_aqui
